# Copie este arquivo para .env.local e preencha com valores reais.
# Nenhum valor aqui é real — são só exemplos/placeholders.
# Lista levantada com grep -r "process.env\." em client/ — ver README.md.

# URL pública do site (usada em links de email, OG/canonical, webhooks, etc.)
WEBSITE_URL=http://localhost:3000

# Multi-loja (opcional). Vazio = modo loja única, tudo cai em DEFAULT_STORE_ID.
ROOT_DOMAIN=
DEFAULT_STORE_ID=1

# Banco de dados (Postgres)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_PORT=5432

# JWT — sessão de cliente/staff (auth_token)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# JWT — super-admin /dev (dev_auth_token). Opcional: sem isso, um valor é
# gerado aleatoriamente a cada boot do processo (sessões /dev caem a cada
# restart — aceitável pra essa área de baixo tráfego).
DEV_JWT_SECRET=
DEV_JWT_EXPIRES_IN=12h

# Segredo pra chamadas internas servidor-a-servidor (proxy.ts -> /api/internal/*).
# Obrigatória — gere um valor aleatório só pra isso, nunca reuse JWT_SECRET.
INTERNAL_API_SECRET=

# Segunda camada exigida em TODAS as rotas /api/internal/** (sync-user,
# cron/*), além do segredo específico de cada uma (INTERNAL_API_SECRET /
# CRON_SECRET) — enviada no header x-internal-orchestrator. Gere um valor
# aleatório PRÓPRIO (nunca reuse INTERNAL_API_SECRET/CRON_SECRET/JWT_SECRET).
# Sem essa env configurada, TODAS as rotas /api/internal/** recusam
# qualquer chamada (fail closed) — inclusive a sincronização de permissão
# do staff no dashboard. Isso é defesa em camadas, NÃO substitui bloquear
# /api/internal/* no proxy/reverse-proxy pra tráfego externo quando houver
# um na frente da origem — ver docs/security/csp.md pro mesmo princípio
# aplicado à CSP.
INTERNAL_ORCHESTRATOR_TOKEN=

# E-mail (nodemailer via Gmail SMTP) — login por código, notificações de pedido
EMAIL_USER=
EMAIL_PASS=

# Login social — Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login social — Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_TOKEN=
DISCORD_CLIENT_SECRET=
DISCORD_SCOPES=identify,email,guilds,guilds.join
WEBHOOK_URL=

# Pagamentos — Mercado Pago (credenciais da própria loja/dono)
# PAYMENT_PROVIDER=mock força o provider de teste mesmo com credenciais
# reais configuradas (nunca funciona em produção — ver lib/payments/index.ts).
PAYMENT_PROVIDER=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SANDBOX=false

# Frete — SHIPPING_PROVIDER=fixed_table força a tabela fixa local em dev
# (credenciais do Melhor Envio continuam vindo do banco, não de env var).
SHIPPING_PROVIDER=

# Cron — expiração de pedidos pendentes e recuperação de carrinho
# abandonado (ver README, seção "Cron jobs")
ORDER_EXPIRATION_HOURS=24
ABANDONED_CART_HOURS=24
CRON_SECRET=

# Dev server — origens externas liberadas (túnel ngrok/Cloudflare etc.),
# separadas por vírgula. Vazio = só localhost.
DEV_ALLOWED_ORIGINS=

# Analytics/conversão — opcionais, sem nenhum não carrega nenhum script.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# Quem fornece a plataforma (não a loja) — único lugar configurável pra
# esse nome/contato. Usado no contrato em /termos-plataforma e na linha
# de rodapé "Loja criada com ...".
PLATFORM_LEGAL_NAME=
PLATFORM_CONTACT_EMAIL=
