# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Arquivos privados do cliente (anexos de chat) e conteúdo digital vendido
# (chaves/arquivos de produtos) — nunca podem ir pro histórico do git, são
# dados de cliente/propriedade vendida, não código. Uploads públicos
# (imagens de produto, loja, avatares) também ficam fora: crescem sem
# limite e não servem pra nada versionados. O .gitkeep garante que a
# pasta continua existindo num checkout novo.
!/private/chat/
/private/chat/*
!/private/chat/.gitkeep

/stock/products/uploads/*
!/stock/products/uploads/.gitkeep

/public/uploads/*
!/public/uploads/.gitkeep
